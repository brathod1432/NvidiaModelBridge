# Copy this file to .env and add your real key locally.
# Never commit .env.

# NVIDIA API Configuration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_BRIDGE_HOST=0.0.0.0
NVIDIA_MODEL_BRIDGE_PORT=8000
NVIDIA_DEFAULT_TASK_TYPE=general
NVIDIA_SERVICE_TIMEOUT_SECONDS=90

# Benchmark Settings
NVIDIA_BENCHMARK_TIMEOUT_SECONDS=45
NVIDIA_BENCHMARK_MODEL_LIMIT=0
NVIDIA_ENABLE_DISCOVERY=true
NVIDIA_TEST_STREAMING=false
NVIDIA_BENCHMARK_MAX_WORKERS=5

# --- Security Settings ---

# API Key for gateway consumers (comma-separated for multiple keys)
# If empty, authentication is disabled (open access)
# Generate keys with: python -c "import secrets; print(f'nvbridge-{secrets.token_urlsafe(32)}')"
NVIDIA_BRIDGE_API_KEY=
NVIDIA_BRIDGE_AUTH_ENABLED=false

# CORS origins (comma-separated, use * for all)
NVIDIA_BRIDGE_CORS_ORIGINS=*

# Rate limiting (requests per window)
NVIDIA_BRIDGE_RATE_LIMIT=60
NVIDIA_BRIDGE_RATE_WINDOW=60

# Input limits
NVIDIA_BRIDGE_MAX_PROMPT_LENGTH=100000
NVIDIA_BRIDGE_MAX_MESSAGE_COUNT=100

# --- Infrastructure Settings ---

# Caching
NVIDIA_BRIDGE_ENABLE_CACHE=true
NVIDIA_BRIDGE_CACHE_MAXSIZE=1000
NVIDIA_BRIDGE_CACHE_TTL=300

# Circuit Breaker
NVIDIA_BRIDGE_CB_THRESHOLD=5
NVIDIA_BRIDGE_CB_RECOVERY=60

# Metrics and Logging
NVIDIA_BRIDGE_ENABLE_METRICS=true
NVIDIA_BRIDGE_ENABLE_REQUEST_LOG=true
NVIDIA_BRIDGE_LOG_LEVEL=INFO
NVIDIA_BRIDGE_LOG_JSON=false

# --- Feature Flags ---
NVIDIA_BRIDGE_ENABLE_STREAMING=true
NVIDIA_BRIDGE_ENABLE_SYSTEM_PROMPTS=true
NVIDIA_BRIDGE_ENABLE_ANALYTICS=true
NVIDIA_BRIDGE_ENABLE_JOB_QUEUE=true
